{
  "expo": {
    "name": "AstroKuldevi",
    "slug": "astrokuldevi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/astrokuldevi/logo.png",
    "scheme": "astrokuldeviapp",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/astrokuldevi/logo.png"
    },
    "android": {
      "package": "com.astrokuldevi.app",
      "adaptiveIcon": {
        "backgroundColor": "#171126",
        "foregroundImage": "./assets/astrokuldevi/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/astrokuldevi/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#171126",
          "image": "./assets/astrokuldevi/logo.png",
          "imageWidth": 180
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "964e32b9-eb99-474d-a1aa-9a46b4a597dc"
      }
    }
  }
}
